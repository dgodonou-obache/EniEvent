# =============================================================================
# Copiez ce fichier vers .env.local et renseignez les valeurs.
# .env.local est ignoré par Git (.gitignore : `.env*`) — ne jamais le committer.
# =============================================================================

# --- Supabase ---------------------------------------------------------------
# Tableau de bord Supabase > votre projet > Settings > API Keys.
# https://supabase.com/dashboard/project/_/settings/api-keys

# Settings > Data API  (ex. https://abcdefghijkl.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé « publishable » (sb_publishable_...). Publique, exposée au navigateur :
# c'est normal, la RLS est ce qui protège les données.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé « secret » (sb_secret_...). Contourne la RLS.
# Webhooks et tâches planifiées uniquement — jamais dans du code client.
SUPABASE_SECRET_KEY=

# Les anciennes clés (anon / service_role, longs JWT en « eyJ ») restent
# acceptées via NEXT_PUBLIC_SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY,
# mais Supabase les supprime fin 2026 : préférez les deux clés ci-dessus.

# --- Application ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Paiement (FedaPay) -----------------------------------------------------
# https://fedapay.com — tableau de bord > Développeurs > Clés API.
# La clé porte son environnement (sk_sandbox_… ou sk_live_…) : c'est elle qui
# décide vers quelle API les paiements partent, pas une variable à part qu'on
# oublierait de basculer.
FEDAPAY_SECRET_KEY=
NEXT_PUBLIC_FEDAPAY_PUBLIC_KEY=
# « sandbox » ou « live ». Absente, l'environnement est déduit de la clé.
FEDAPAY_ENVIRONMENT=sandbox
# Secret de signature des webhooks. ⚠️ Non exposé par l'API : à relever dans le
# tableau de bord. Absent, le webhook reste sûr — il ne sert que de signal, et
# la transaction est relue chez FedaPay avant tout encaissement.
FEDAPAY_WEBHOOK_SECRET=

# --- Email (Resend) ---------------------------------------------------------
# https://resend.com — tableau de bord > API Keys. Une clé « Sending access »
# suffit au fonctionnement ; « Full access » n'est utile que pour déclarer un
# domaine par l'API.
# Sans clé, les envois sont journalisés au lieu de partir, comme pour les SMS.
RESEND_API_KEY=

# Expéditeur. ⚠️ Son domaine doit être VÉRIFIÉ chez Resend, sans quoi tout envoi
# échoue en HTTP 403 — dont le libellé parle de domaine, pas de clé, et fait
# chercher du côté de l'authentification. Voir docs/DEPLOIEMENT.md.
EMAIL_FROM="ÉniEvent <bonjour@enievent.com>"

# Adresse à laquelle répondre. L'expéditeur ci-dessus est une adresse d'envoi
# que personne ne relève : sans cette valeur, la réponse d'un client se perd.
EMAIL_REPLY_TO=contact@enievent.com

# Destinataire de `npm run smoke:email`. Absent, l'envoi réel est ignoré.
EMAIL_TEST_TO=

# --- SMS (Premux) -----------------------------------------------------------
# Passerelle béninoise. https://premux.bj — tableau de bord > API.
# Sans clé, les envois sont journalisés au lieu de partir : le développement
# local ne consomme donc aucun crédit.
PREMUX_API_KEY=
# Domaine auquel VOTRE clé est rattachée, envoyé dans l'en-tête X-Premux-Domain.
# ⚠️ Ce n'est pas « premux.bj » : la documentation de Premux montre son propre
# domaine dans l'exemple, et le recopier donne un HTTP 403 DOMAIN_NOT_ALLOWED.
PREMUX_DOMAIN=
# Nom affiché à la place d'un numéro. À faire déclarer auprès de MTN, Moov et
# Celtiis : non déclaré, il est remplacé ou le message ne part pas.
PREMUX_SENDER_ID=

# Numéro destinataire de `npm run smoke:sms`. Absent, l'envoi réel est ignoré.
SMS_TEST_TO=

# --- Démonstration ---------------------------------------------------------
# Mot de passe commun aux quatre comptes de démonstration. Aléatoire, jamais
# committé : demo-admin est de type admin et le dépôt est public.
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
DEMO_PASSWORD=

# --- Courrier sortant (scripts) --------------------------------------------
# Boîte OVH utilisée par npm run admin:creer pour transmettre un mot de passe
# sans le faire transiter par un terminal. Les e-mails de l'application, eux,
# passent par le SMTP déclaré côté Supabase.
MAIL_USER=
MAIL_PASS=

# --- Sessions --------------------------------------------------------------
# Signe l'horodatage d'activité qui fait expirer les sessions inactives
# (14 jours, 1 heure sur /admin). Absent, le délai est inactif — aucune
# signature bidon, qui donnerait l'illusion d'une protection.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Tâches planifiées ------------------------------------------------------
# Jeton partagé protégeant les routes /api/cron/*.
CRON_SECRET=
